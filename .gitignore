.well-known

# Copyrighted show scripts are installed separately in production.
show-scripts/*
!show-scripts/pirates_test_script.html

# Writable deployment data. Keep local/production JSON across deployments,
# but never publish live show state, cues, or annotations in the repository.
scripts/passwords.php
scripts/teleprompter_state/*.json
!scripts/teleprompter_state/.gitkeep
show-cues/*.json
!show-cues/.gitkeep
show-annotations/*.json
!show-annotations/.gitkeep
